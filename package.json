{
  "name": "agent-hub-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:skill-market-client": "tsx scripts/generate-skill-market-client.ts",
    "generate:kb-client": "tsx scripts/generate-kb-client.ts",
    "generate:conversation-client": "tsx scripts/generate-conversation-client.ts",
    "check:kb-client": "tsx scripts/check-kb-client.ts",
    "check:conversation-client": "tsx scripts/check-conversation-client.ts",
    "check:skill-market-client": "tsx scripts/check-skill-market-client.ts",
    "check:skill-market-sensitive-data": "tsx scripts/check-skill-market-sensitive-data.ts",
    "test:skill-market:database-boundary": "tsx scripts/test-skill-market-database-boundary.ts",
    "test:skill-market:existing-data": "tsx scripts/test-skill-market-existing-data.ts",
    "test:skill-market:independence": "vitest run scripts/skill-market-independence.test.ts && tsx scripts/check-skill-market-independence.ts",
    "test:skill-market:parallel": "tsx scripts/test-skill-market-parallel-run.ts",
    "test:skill-market:bff": "vitest run src/features/skills/api",
    "test:skill-market:components": "vitest run src/features/skills/authoring src/features/skills/catalog src/features/skills/components src/features/skills/creator src/features/skills/publication src/features/skills/review",
    "test:skill-market:contract": "vitest run scripts/skill-market-client-generator.test.ts scripts/skill-market-schema-lock.test.ts scripts/skill-market-sensitive-data.test.ts src/features/skills/contracts",
    "test:skill-market:security": "vitest run src/features/skills/api src/features/skills/contracts/error.test.ts src/features/skills/components/skill-market-error-state.test.tsx src/features/skills/publication/artifact-download.test.ts src/features/skills/publication/skill-publication.test.tsx",
    "verify:skill-market-schema": "tsx scripts/verify-skill-market-schema.ts",
    "verify:kb-schema": "tsx scripts/verify-kb-schema.ts",
    "verify:conversation-schema": "tsx scripts/verify-conversation-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:skill-market": "playwright test e2e/skill-catalog.spec.ts e2e/skill-market-lifecycle.spec.ts e2e/skill-market-security.spec.ts",
    "test:e2e:daily-session": "playwright test --config=playwright.daily-session.config.ts",
    "test:e2e:thin-loop": "playwright test --config=playwright.thin-loop.config.ts",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "smoke:daily-session-j1": "node scripts/daily-session-j1-smoke.mjs",
    "verify:skill-market:release": "pnpm run verify:skill-market-schema && pnpm run check:skill-market-client && pnpm run test:skill-market:database-boundary && pnpm run test:skill-market:independence && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run test:e2e && pnpm run build && pnpm run check:skill-market-sensitive-data",
    "test:e2e:mcp-container": "playwright test --config=playwright.mcp-container.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.1.1",
    "jsdom": "^27.1.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  }
}
