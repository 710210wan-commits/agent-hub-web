# mock | projects-new
NEXT_PUBLIC_CHAT_TRANSPORT=mock

# Browser-visible same-origin path only.
NEXT_PUBLIC_AGENT_API_BASE=/agent-api

# Server-only projects_new upstream used by Next.js rewrites.
# For daily Session writes, configure projects_new DSI_ALLOWED_ORIGINS with
# the exact public Agent Hub origin (scheme + host + optional port).
AGENT_API_ORIGIN=http://127.0.0.1:3001

# Server-only Xiaozhi work-mode BFF. Never rename the key to NEXT_PUBLIC_*.
# The current key identifies one shared demo user, so every visitor sees the
# same work-mode conversation history. Replace this after unified auth lands.
# Health: http://127.0.0.1:5050/api/system/health
XIAOZHI_API_ORIGIN=http://127.0.0.1:5050
XIAOZHI_API_KEY=
XIAOZHI_WORK_AGENT_SLUG=default-chatbot

# Server-only daily Skill Market backend Origin. Required at startup/build.
# Do not rename this to NEXT_PUBLIC_* or include a path/query/fragment.
SKILL_MARKET_DAILY_ORIGIN=http://127.0.0.1:3000

# Server-only gateway Principal used by the Skill Market BFF.
# Replace the example secret in every environment; minimum length is 32 characters.
SKILL_MARKET_GATEWAY_HMAC_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes
SKILL_MARKET_PRINCIPAL_ID=agent-hub-operator
SKILL_MARKET_PRINCIPAL_ROLES=author,reviewer,admin,scenario_admin
SKILL_MARKET_PRINCIPAL_MANAGED_SCENARIOS=daily
SKILL_MARKET_PRINCIPAL_PERMISSIONS=

# Connection/response timeout for the same-origin Skill Market BFF (milliseconds).
SKILL_MARKET_BFF_TIMEOUT_MS=30000

# Legacy Cesium frontend. Development defaults to http://localhost:5000;
# production builds must explicitly set the deployed HTTP(S) origin.
NEXT_PUBLIC_LEGACY_FRONTEND_URL=http://localhost:5000
