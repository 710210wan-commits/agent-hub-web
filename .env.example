# mock | projects-new
NEXT_PUBLIC_CHAT_TRANSPORT=mock

# Browser-visible same-origin path only.
NEXT_PUBLIC_AGENT_API_BASE=/agent-api

# Server-only upstream used by Next.js rewrites in a later task.
AGENT_API_ORIGIN=http://127.0.0.1:3001

# Legacy Cesium frontend. Development defaults to http://localhost:5000;
# production builds must explicitly set the deployed HTTP(S) origin.
NEXT_PUBLIC_LEGACY_FRONTEND_URL=http://localhost:5000
